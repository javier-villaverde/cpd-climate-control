# Copia este fichero a .env y ajusta los valores. Docker Compose lo lee solo.
# Las variables de Python (SENSOR_HTTP_URL, *_SN) se exportan en el shell.

# Contrasena del usuario admin de Grafana (obligatoria)
GRAFANA_ADMIN_PASSWORD=change-me

# URL del exporter de temperatura (por defecto, la misma maquina)
# SENSOR_HTTP_URL=http://localhost:8001/temperatura

# Numeros de serie de los sensores USB (opcional; ver sensor_exporter.py)
# COLD_AISLE_SN=
# HOT_AISLE_SN=
